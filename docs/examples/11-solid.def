# Compounds written as one word, so the join is subject to the language's phonology.
seed: solid

C: t k p s l m n
N: m n
V: a i u e o

syllable: CV CVN
word-syllables: 1 2

stress: initial
syllable-separator: .

compounds: yes
compound-rate: 40%
compound-order: head-final

% p  t  k
m +  nt ŋk
n mp +  ŋk
